@using ASP_Lesson_14.Models.ViewModels.Cart;
@model CartIndexVM
@{
    ViewData["Title"] = "Index";
    int index = 0;
}
<h1>Cart</h1>
<div class="col-3"></div>
<div class="col">

    <table class="table">
        <thead>
            <tr>
                <th>#</th>
                <th>Photo</th>
                <th>Product Name</th>
                <th>Product Price,UAH</th>
                <th>Count</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (CartItem item in Model.CartItems)
            {
                <tr>
                    <td>@(++index)</td>
                    <td>
                        <img src="@Url.Action("ProductImage", "Cart", new { id = item.ProductId })"
                             alt="@item.Name"
                             style="height:100px; width:auto;object-fit:contain" class="card-img-top" />
                    </td>
                    <td>@item.Name</td>
                    <td>@item.Price</td>
                    <td class="item-count" data-row-id="@item.ProductId">
                        <div class="d-flex text-center">
                            <span class="flex-fill rounded-start border p-2"
                                  onclick="decCount(event,@item.ProductId)">-</span>
                            <span class="flex-fill border p-2">@item.Count</span>
                            <span class="flex-fill rounded-end border p-2"
                                  onclick="incCount(event,@item.ProductId)">+</span>
                        </div>
                    </td>
                    <td>@item.TotalPrice</td>
                    <td>
                      <form asp-action="RemoveFromCart" asp-controller="Cart" method="post">
                            <input type="hidden" name="id" value="@item.ProductId" />
                            <button type="submit" class="btn btn-danger">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-x" viewBox="0 0 16 16">
                                    <path d="M6.146 6.146a.5.5 0 0 1 .708 0L8 7.293l1.146-1.147a.5.5 0 1 1 .708.708L8.707 8l1.147 1.146a.5.5 0 0 1-.708.708L8 8.707 6.854 9.854a.5.5 0 0 1-.708-.708L7.293 8 6.146 6.854a.5.5 0 0 1 0-.708" />
                                    <path d="M4 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zm0 1h8a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1" />
                                </svg>
                            </button>
                        </form>
                    </td>
                </tr>
            }
            <tr>
                <td colspan="5" class="text-end">Total price:</td>
             <td id="totalPrice">@Model.TotalPrice UAH</td>
            </tr>
        </tbody>
    </table>
</div>
@section Scripts {
    <script type="text/javascript">
                  async function incCount(e, productId) {
            let resp = await fetch(`/Cart/IncCount/${productId}`, {
                method: 'post',
                headers: {
                    accept: 'application/json'
                }
            })
            if (resp.ok == true) {
                let info = await resp.json()
                console.log(info)
                console.log(`Prod count ${info.count}`)
                let currentSpan = e.target
                currentSpan.previousElementSibling.innerText = info.count
                currentSpan.parentElement.parentElement.nextElementSibling.innerText = info.totalPrice;
                await getTotalPrice()
            }
        }
        async function getTotalPrice() {
            let resp = await fetch(`/Cart/getTotalPrice`, {
                method: 'post',
                headers: {
                    accept: 'application/json'
                }
            })
            if (resp.ok == true) {
                let info = await resp.json();
                let totalPriceId = document.getElementById('totalPrice')
                totalPriceId.innerText = info.totalPrice
            }
        }

       async function decCount(e,productId){
            let resp = await fetch(`/Cart/DecCount/${productId}`, {
                method: 'post',
                headers: {
                    accept: 'application/json'
                }
            })
            if (resp.ok == true) {
                let info = await resp.json()
                console.log(info)
                console.log(`Prod count ${info.count}`)
                let currentSpan = e.target
                if(info.count == 0){
                  let currentId= currentSpan.parentElement.parentElement.parentElement;
                  currentId.remove();
                }   
                else{
                currentSpan.nextElementSibling.innerText = info.count;
                currentSpan.parentElement.parentElement.nextElementSibling.innerText = info.totalPrice;
                }
                await getTotalPrice();
                
            }
       }
    </script>

}

